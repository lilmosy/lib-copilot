# 이 파일을 .env로 복사해 값을 채운다.  cp .env.example .env
# 상위 폴더(모노레포 루트)의 .env도 자동으로 찾는다.

# 판단(LLM) — 필수.  https://console.anthropic.com
ANTHROPIC_API_KEY=

# 책소개 — 선택(없어도 파이프라인은 돈다. 책소개 없이 판단할 뿐).
# 알라딘 → 오픈API → TTB 인증키 발급 (무료).  http://www.aladin.co.kr/ttb/wblog_manage.aspx
ALADIN_TTB_KEY=

# 파일럿 기본값: 후보·점수·근거를 사서가 검토한다. 충분한 실증 뒤에만 on으로 켠다.
# LIBCOPILOT_AUTO_CONFIRM=off
# LIBCOPILOT_EARLY_STOP=off

# ── 아래는 현재 코드에서 쓰지 않는다 ──
# 국립중앙도서관 Open API. 12권 실측 결과 목차·책소개 커버리지가 낮아 알라딘으로 대체했다.
# (docs/design.md §4.1) 다시 시도할 때를 위해 자리만 남긴다.  https://www.nl.go.kr/NL/contents/N31101030700.do
# NL_API_KEY=
